{
  "name": "imovies-platform",
  "version": "1.0.0",
  "description": "IMovies - Modern Cinema Ticket Reservation and Real-time Seat Booking Platform",
  "scripts": {
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "seed": "cd server && npm run seed",
    "start": "cd server && npm start"
  },
  "keywords": [
    "imovies",
    "cinema-booking",
    "mern",
    "seat-reservation",
    "express",
    "mongodb",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
